generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  SCHOOL_ADMIN
  TEACHER
  ACCOUNTANT
  RECEPTIONIST
  PARENT
  STUDENT
}

model AcademicYear {
  id String @id @default(cuid())

  name String

  startDate DateTime
  endDate   DateTime

  active Boolean @default(false)

  attendanceMode AttendanceMode @default(ONCE_DAILY)

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  enrollments        StudentEnrollment[]
  allocations        TeacherAllocation[]
  timetables         Timetable[]
  attendanceSessions AttendanceSession[]
  homeworks          Homework[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, name])
}

model School {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  academicYears      AcademicYear[]
  memberships        Membership[]
  students           Student[]
  classes            Class[]
  studentEnrollments StudentEnrollment[]
  subjects           Subject[]
  teachers           Teacher[]
  teacherAllocations TeacherAllocation[]
  periods            Period[]
  timetables         Timetable[]
  attendanceSessions AttendanceSession[]
  attendance         Attendance[]
  homeworks          Homework[]
}

model User {
  id          String  @id @default(cuid())
  clerkUserId String  @unique
  email       String  @unique
  firstName   String?
  lastName    String?
  imageUrl    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
}

model Membership {
  id String @id @default(cuid())

  userId   String
  schoolId String

  role Role

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([userId, schoolId])
}

model Student {
  id String @id @default(cuid())

  // ==========================
  // Admission
  // ==========================

  admissionNo String
  username    String?
  clerkId     String?

  // ==========================
  // Basic Information
  // ==========================

  fullName String?

  gender     Gender
  dob        DateTime
  joinedDate DateTime?

  bloodGroup   String?
  nationality  String?
  motherTongue String?

  religion Religion?
  category Category?
  caste    String?
  subCaste String?

  // ==========================
  // Government IDs
  // ==========================

  penNo         String?
  emisNo        String?
  apaarId       String?
  studentAadhar String?

  // ==========================
  // Contact
  // ==========================

  phone          String?
  alternatePhone String?
  email          String?

  address  String?
  city     String?
  district String?
  state    String?
  country  String?
  pincode  String?

  // ==========================
  // Parent Information
  // ==========================

  fatherName          String?
  fatherPhone         String?
  fatherEmail         String?
  fatherOccupation    String?
  fatherQualification String?
  fatherIncome        Decimal?

  motherName          String?
  motherPhone         String?
  motherEmail         String?
  motherOccupation    String?
  motherQualification String?
  motherIncome        Decimal?

  guardianName     String?
  guardianRelation String?
  guardianPhone    String?

  // ==========================
  // Identity
  // ==========================

  fatherAadhar String?
  motherAadhar String?

  // ==========================
  // Medical
  // ==========================

  allergies         String?
  medicalConditions String?
  doctorName        String?
  doctorPhone       String?

  // ==========================
  // School
  // ==========================

  transportRequired Boolean @default(false)
  hostelRequired    Boolean @default(false)

  // ==========================
  // Photo
  // ==========================

  imageUrl String?

  // ==========================
  // Status
  // ==========================

  status StudentStatus @default(ACTIVE)

  statusChangedAt DateTime?

  statusRemarks String?

  remarks String?

  // ==========================
  // Tenant
  // ==========================

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  enrollments StudentEnrollment[]
  attendance  Attendance[]

  // ==========================
  // Audit
  // ==========================

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, admissionNo])
  @@index([schoolId])
  @@index([status])
  @@index([schoolId, fullName])
  @@index([schoolId, phone])
}

model Class {
  id String @id @default(cuid())

  name        String
  code        String?
  description String?

  displayOrder Int @default(0)

  active Boolean @default(true)

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  sections    Section[]
  enrollments StudentEnrollment[]

  allocations        TeacherAllocation[]
  attendanceSessions AttendanceSession[]
  homeworks          Homework[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, name])
  @@index([schoolId])
}

model Section {
  id String @id @default(cuid())

  name String

  displayOrder Int @default(0)

  active Boolean @default(true)

  classId String
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  enrollments        StudentEnrollment[]
  allocations        TeacherAllocation[]
  attendanceSessions AttendanceSession[]
  homeworks          Homework[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classId, name])
}

model StudentEnrollment {
  id String @id @default(cuid())

  schoolId String

  studentId String

  academicYearId String

  classId String

  sectionId String

  rollNo Int?

  admissionDate DateTime?

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  active Boolean @default(true)

  promotedFromId String?
  promotedFrom   StudentEnrollment?  @relation("PromotionHistory", fields: [promotedFromId], references: [id])
  promotedTo     StudentEnrollment[] @relation("PromotionHistory")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, academicYearId])
  @@unique([academicYearId, classId, sectionId, rollNo])
  @@index([schoolId])
  @@index([studentId])
  @@index([academicYearId])
  @@index([classId])
  @@index([sectionId])
  @@index([schoolId, active])
  @@index([academicYearId, classId, sectionId])
}

model Subject {
  id String @id @default(cuid())

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  name String
  code String?

  type SubjectType @default(SCHOLASTIC)

  displayOrder Int @default(0)

  active Boolean @default(true)

  allocations        TeacherAllocation[]
  attendanceSessions AttendanceSession[]
  homeworks          Homework[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, name])
  @@index([schoolId])
}

model Teacher {
  id String @id @default(cuid())

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  employeeId String

  clerkId  String?
  username String?

  fullName String

  gender Gender

  dob DateTime?

  joiningDate DateTime?

  phone          String?
  alternatePhone String?

  email String?

  qualification String?

  designation String?

  experience Int?

  bloodGroup String?

  imageUrl String?

  address String?

  city String?

  district String?

  state String?

  pincode String?

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  allocations        TeacherAllocation[]
  attendanceSessions AttendanceSession[]
  homeworks          Homework[]

  @@unique([schoolId, employeeId])
  @@index([schoolId])
}

model TeacherAllocation {
  id String @id @default(cuid())

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  classId String
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  sectionId String
  section   Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  timetables Timetable[]

  active Boolean @default(true)

  remarks String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, academicYearId, teacherId, subjectId, classId, sectionId])
  @@index([schoolId])
}

model Period {
  id String @id @default(cuid())

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  name String

  startTime String

  endTime String

  displayOrder Int @default(0)

  active Boolean @default(true)

  timetables         Timetable[]
  attendanceSessions AttendanceSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, name])
  @@index([schoolId])
}

model Timetable {
  id String @id @default(cuid())

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])

  teacherAllocationId String
  teacherAllocation   TeacherAllocation @relation(fields: [teacherAllocationId], references: [id])

  periodId String
  period   Period @relation(fields: [periodId], references: [id])

  day WeekDay

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([academicYearId, day, periodId, teacherAllocationId])
  @@index([schoolId])
  @@index([academicYearId])
  @@index([teacherAllocationId])
  @@index([periodId])
}

model AttendanceSession {
  id String @id @default(cuid())

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])

  teacherId String?
  teacher   Teacher? @relation(fields: [teacherId], references: [id])

  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id])

  classId String
  class   Class  @relation(fields: [classId], references: [id])

  sectionId String
  section   Section @relation(fields: [sectionId], references: [id])

  sessionType AttendanceSessionType?

  periodId String?
  period   Period? @relation(fields: [periodId], references: [id])

  attendanceDate DateTime @db.Date

  remarks String?

  locked Boolean @default(false)

  records Attendance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId, attendanceDate])
  @@index([schoolId, academicYearId, classId, sectionId, attendanceDate])
}

model Attendance {
  id String @id @default(cuid())

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  sessionId String
  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  status AttendanceStatus

  remarks String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, studentId])
  @@index([studentId])
}

model Homework {
  id String @id @default(cuid())

  schoolId String

  academicYearId String?
  teacherId      String?
  subjectId      String?
  classId        String
  sectionId      String?

  title       String
  description String?

  assignedDate DateTime  @default(now())
  dueDate      DateTime?

  active Boolean @default(true)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  teacher Teacher? @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  section Section? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([academicYearId])
  @@index([teacherId])
  @@index([subjectId])
  @@index([classId])
  @@index([sectionId])
  @@index([schoolId, academicYearId])
  @@index([schoolId, dueDate])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  LEAVE
}

enum AttendanceMode {
  ONCE_DAILY
  MORNING_AFTERNOON
  EVERY_PERIOD
}

enum AttendanceSessionType {
  DAILY
  MORNING
  AFTERNOON
  PERIOD
}

enum WeekDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

enum SubjectType {
  SCHOLASTIC
  CO_SCHOLASTIC
}

enum StudentStatus {
  ACTIVE
  TC_ISSUED
  ALUMNI
  DROPPED
  NOT_COMING
  INACTIVE
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum Religion {
  HINDU
  MUSLIM
  CHRISTIAN
  SIKH
  BUDDHIST
  JAIN
  OTHER
}

enum Category {
  GENERAL
  OBC
  BC_A
  BC_B
  BC_C
  BC_D
  BC_E
  SC
  ST
  EWS
  RTE
}
