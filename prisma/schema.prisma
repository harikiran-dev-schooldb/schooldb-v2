generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AcademicYear {
  id String @id @default(cuid())

  name String

  startDate DateTime
  endDate   DateTime

  active Boolean @default(false)

  attendanceMode AttendanceMode @default(ONCE_DAILY)

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  enrollments        StudentEnrollment[]
  allocations        TeacherAllocation[]
  timetables         Timetable[]
  attendanceSessions AttendanceSession[]
  homeworks          Homework[]
  exams              Exam[]

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  academicPeriods AcademicPeriod[]
  feePlans        FeePlan[]

  @@unique([schoolId, name])
}

model AcademicPeriod {
  id String @id @default(cuid())

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  name      String
  shortName String?

  startDate DateTime @db.Date
  endDate   DateTime @db.Date

  sequence Int

  active Boolean @default(true)

  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  installments FeeInstallment[]

  @@unique([academicYearId, name])
  @@unique([academicYearId, sequence])
  @@index([schoolId, academicYearId])
}

model School {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logo String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  academicYears      AcademicYear[]
  memberships        Membership[]
  students           Student[]
  classes            Class[]
  studentEnrollments StudentEnrollment[]
  subjects           Subject[]
  teachers           Teacher[]
  teacherAllocations TeacherAllocation[]
  periods            Period[]
  timetables         Timetable[]
  attendanceSessions AttendanceSession[]
  attendance         Attendance[]
  homeworks          Homework[]
  academicPeriods    AcademicPeriod[]
  feeCategories      FeeCategory[]
  feePlans           FeePlan[]
  studentFees        StudentFee[]
  feePayments        FeePayment[]
  exams              Exam[]
  examSchedules      ExamSchedule[]
  studentExamMarks   StudentExamMark[]
}

model User {
  id          String  @id @default(cuid())
  clerkUserId String  @unique
  email       String  @unique
  firstName   String?
  lastName    String?
  imageUrl    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
}

model Membership {
  id String @id @default(cuid())

  userId   String
  schoolId String

  role Role

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([userId, schoolId])
}

model Student {
  id String @id @default(cuid())

  // ==========================
  // Admission
  // ==========================

  admissionNo String
  username    String?
  clerkId     String?

  // ==========================
  // Basic Information
  // ==========================

  fullName String?

  gender     Gender
  dob        DateTime
  joinedDate DateTime?

  bloodGroup   String?
  nationality  String?
  motherTongue String?

  religion Religion?
  category Category?
  caste    String?
  subCaste String?

  // ==========================
  // Government IDs
  // ==========================

  penNo         String?
  emisNo        String?
  apaarId       String?
  studentAadhar String?

  // ==========================
  // Contact
  // ==========================

  phone          String?
  alternatePhone String?
  email          String?

  address  String?
  city     String?
  district String?
  state    String?
  country  String?
  pincode  String?

  // ==========================
  // Parent Information
  // ==========================

  fatherName          String?
  fatherPhone         String?
  fatherEmail         String?
  fatherOccupation    String?
  fatherQualification String?
  fatherIncome        Decimal?

  motherName          String?
  motherPhone         String?
  motherEmail         String?
  motherOccupation    String?
  motherQualification String?
  motherIncome        Decimal?

  guardianName     String?
  guardianRelation String?
  guardianPhone    String?

  // ==========================
  // Identity
  // ==========================

  fatherAadhar String?
  motherAadhar String?

  // ==========================
  // Medical
  // ==========================

  allergies         String?
  medicalConditions String?
  doctorName        String?
  doctorPhone       String?

  // ==========================
  // School
  // ==========================

  transportRequired Boolean @default(false)
  hostelRequired    Boolean @default(false)

  // ==========================
  // Photo
  // ==========================

  imageUrl String?

  // ==========================
  // Status
  // ==========================

  status StudentStatus @default(ACTIVE)

  statusChangedAt DateTime?

  statusRemarks String?

  remarks String?

  // ==========================
  // Tenant
  // ==========================

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  enrollments StudentEnrollment[]
  attendance  Attendance[]

  // ==========================
  // Audit
  // ==========================

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, admissionNo])
  @@index([schoolId])
  @@index([status])
  @@index([schoolId, fullName])
  @@index([schoolId, phone])
}

model Class {
  id String @id @default(cuid())

  name        String
  code        String?
  description String?

  displayOrder Int @default(0)

  active Boolean @default(true)

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  sections    Section[]
  enrollments StudentEnrollment[]

  allocations        TeacherAllocation[]
  attendanceSessions AttendanceSession[]
  homeworks          Homework[]
  examSchedules      ExamSchedule[]

  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  feePlans  FeePlanClass[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model Section {
  id String @id @default(cuid())

  name String

  displayOrder Int @default(0)

  active Boolean @default(true)

  classId String
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  enrollments        StudentEnrollment[]
  allocations        TeacherAllocation[]
  attendanceSessions AttendanceSession[]
  homeworks          Homework[]
  examSchedules      ExamSchedule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classId, name])
}

model StudentEnrollment {
  id String @id @default(cuid())

  schoolId String

  studentId String

  academicYearId String

  classId String

  sectionId String

  rollNo Int?

  admissionDate DateTime?

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  active Boolean @default(true)

  promotedFromId String?
  promotedFrom   StudentEnrollment?  @relation("PromotionHistory", fields: [promotedFromId], references: [id])
  promotedTo     StudentEnrollment[] @relation("PromotionHistory")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentFees StudentFee[]
  feePayments FeePayment[]
  examMarks   StudentExamMark[]

  @@unique([studentId, academicYearId])
  @@unique([academicYearId, classId, sectionId, rollNo])
  @@index([schoolId])
  @@index([studentId])
  @@index([academicYearId])
  @@index([classId])
  @@index([sectionId])
  @@index([schoolId, active])
  @@index([academicYearId, classId, sectionId])
}

model Subject {
  id String @id @default(cuid())

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  name String
  code String?

  type SubjectType @default(SCHOLASTIC)

  displayOrder Int @default(0)

  active Boolean @default(true)

  allocations        TeacherAllocation[]
  attendanceSessions AttendanceSession[]
  homeworks          Homework[]
  examSchedules      ExamSchedule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, name])
  @@index([schoolId])
}

model Teacher {
  id String @id @default(cuid())

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  employeeId String

  clerkId  String?
  username String?

  fullName String

  gender Gender

  dob DateTime?

  joiningDate DateTime?

  phone          String?
  alternatePhone String?

  email String?

  qualification String?

  designation String?

  experience Int?

  bloodGroup String?

  imageUrl String?

  address String?

  city String?

  district String?

  state String?

  pincode String?

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  allocations        TeacherAllocation[]
  attendanceSessions AttendanceSession[]
  homeworks          Homework[]

  @@unique([schoolId, employeeId])
  @@index([schoolId])
}

model TeacherAllocation {
  id String @id @default(cuid())

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  classId String
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  sectionId String
  section   Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  timetables Timetable[]

  active Boolean @default(true)

  remarks String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, academicYearId, teacherId, subjectId, classId, sectionId])
  @@index([schoolId])
}

model Period {
  id String @id @default(cuid())

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  name String

  startTime String

  endTime String

  displayOrder Int @default(0)

  active Boolean @default(true)

  timetables         Timetable[]
  attendanceSessions AttendanceSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, name])
  @@index([schoolId])
}

model Timetable {
  id String @id @default(cuid())

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])

  teacherAllocationId String
  teacherAllocation   TeacherAllocation @relation(fields: [teacherAllocationId], references: [id])

  periodId String
  period   Period @relation(fields: [periodId], references: [id])

  day WeekDay

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([academicYearId, day, periodId, teacherAllocationId])
  @@index([schoolId])
  @@index([academicYearId])
  @@index([teacherAllocationId])
  @@index([periodId])
}

model AttendanceSession {
  id String @id @default(cuid())

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])

  teacherId String?
  teacher   Teacher? @relation(fields: [teacherId], references: [id])

  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id])

  classId String
  class   Class  @relation(fields: [classId], references: [id])

  sectionId String
  section   Section @relation(fields: [sectionId], references: [id])

  sessionType AttendanceSessionType?

  periodId String?
  period   Period? @relation(fields: [periodId], references: [id])

  attendanceDate DateTime @db.Date

  remarks String?

  locked Boolean @default(false)

  records Attendance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId, attendanceDate])
  @@index([schoolId, academicYearId, classId, sectionId, attendanceDate])
}

model Attendance {
  id String @id @default(cuid())

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  sessionId String
  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  status AttendanceStatus

  remarks String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, studentId])
  @@index([studentId])
}

model Homework {
  id String @id @default(cuid())

  schoolId String

  academicYearId String?
  teacherId      String?
  subjectId      String?
  classId        String
  sectionId      String?

  title       String
  description String?

  assignedDate DateTime  @default(now())
  dueDate      DateTime?

  active Boolean @default(true)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  teacher Teacher? @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  section Section? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([academicYearId])
  @@index([teacherId])
  @@index([subjectId])
  @@index([classId])
  @@index([sectionId])
  @@index([schoolId, academicYearId])
  @@index([schoolId, dueDate])
}

model FeeCategory {
  id String @id @default(cuid())

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  name        String
  code        String?
  description String?

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items           FeePlanItem[]
  studentFees     StudentFee[]
  studentFeeItems StudentFeeItem[]

  @@unique([schoolId, name])
  @@index([schoolId, active])
}

model FeePlan {
  id String @id @default(cuid())

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])

  name        String
  description String?

  appliesToAllClasses Boolean @default(false)

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items       FeePlanItem[]
  classes     FeePlanClass[]
  studentFees StudentFee[]

  @@unique([schoolId, academicYearId, name])
  @@index([schoolId, academicYearId])
}

model FeePlanClass {
  id String @id @default(cuid())

  feePlanId String
  feePlan   FeePlan @relation(fields: [feePlanId], references: [id], onDelete: Cascade)

  classId String
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([feePlanId, classId])
  @@index([classId])
}

model FeePlanItem {
  id String @id @default(cuid())

  feePlanId String
  feePlan   FeePlan @relation(fields: [feePlanId], references: [id], onDelete: Cascade)

  feeCategoryId String
  feeCategory   FeeCategory @relation(fields: [feeCategoryId], references: [id])

  frequency FeeFrequency

  amount Decimal @db.Decimal(12, 2)

  mandatory Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  installments       FeeInstallment[]
  customInstallments FeePlanCustomInstallment[]
  studentFees        StudentFee[]
  studentFeeItems    StudentFeeItem[]

  @@index([feePlanId])
  @@index([feeCategoryId])
}

model FeePlanCustomInstallment {
  id String @id @default(cuid())

  feePlanItemId String
  feePlanItem   FeePlanItem @relation(fields: [feePlanItemId], references: [id], onDelete: Cascade)

  name String

  amount Decimal @db.Decimal(12, 2)

  dueDate DateTime @db.Date

  sequence Int

  periodStart DateTime? @db.Date
  periodEnd   DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([feePlanItemId, sequence])
  @@index([feePlanItemId])
}

model FeeInstallment {
  id String @id @default(cuid())

  feePlanItemId String
  feePlanItem   FeePlanItem @relation(fields: [feePlanItemId], references: [id], onDelete: Cascade)

  academicPeriodId String?
  academicPeriod   AcademicPeriod? @relation(fields: [academicPeriodId], references: [id])

  name String

  amount Decimal @db.Decimal(12, 2)

  dueDate DateTime @db.Date

  sequence Int

  periodStart DateTime? @db.Date
  periodEnd   DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentFees            StudentFee[]
  studentFeeInstallments StudentFeeInstallment[]

  @@index([feePlanItemId])
  @@index([academicPeriodId])
  @@index([dueDate])
}

model StudentFee {
  id String @id @default(cuid())

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  studentEnrollmentId String
  studentEnrollment   StudentEnrollment @relation(fields: [studentEnrollmentId], references: [id], onDelete: Cascade)

  feePlanId String
  feePlan   FeePlan @relation(fields: [feePlanId], references: [id])

  assignedAt DateTime @default(now())

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items            StudentFeeItem[]
  feeCategory      FeeCategory?     @relation(fields: [feeCategoryId], references: [id])
  feeCategoryId    String?
  feePlanItem      FeePlanItem?     @relation(fields: [feePlanItemId], references: [id])
  feePlanItemId    String?
  feeInstallment   FeeInstallment?  @relation(fields: [feeInstallmentId], references: [id])
  feeInstallmentId String?

  @@unique([studentEnrollmentId, feePlanId])
  @@index([schoolId, studentEnrollmentId])
  @@index([feePlanId])
}

model StudentFeeItem {
  id String @id @default(cuid())

  studentFeeId String
  studentFee   StudentFee @relation(fields: [studentFeeId], references: [id], onDelete: Cascade)

  feePlanItemId String
  feePlanItem   FeePlanItem @relation(fields: [feePlanItemId], references: [id])

  feeCategoryId String
  feeCategory   FeeCategory @relation(fields: [feeCategoryId], references: [id])

  amount Decimal @db.Decimal(12, 2)

  concession Decimal @default(0) @db.Decimal(12, 2)

  finalAmount Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  installments StudentFeeInstallment[]

  @@index([studentFeeId])
  @@index([feePlanItemId])
  @@index([feeCategoryId])
}

model StudentFeeInstallment {
  id String @id @default(cuid())

  studentFeeItemId String
  studentFeeItem   StudentFeeItem @relation(fields: [studentFeeItemId], references: [id], onDelete: Cascade)

  feeInstallmentId String?
  feeInstallment   FeeInstallment? @relation(fields: [feeInstallmentId], references: [id])

  name String

  amount Decimal @db.Decimal(12, 2)

  concession Decimal @default(0) @db.Decimal(12, 2)

  payableAmount Decimal @db.Decimal(12, 2)

  paidAmount Decimal @default(0) @db.Decimal(12, 2)

  dueDate DateTime @db.Date

  status StudentFeeInstallmentStatus @default(PENDING)

  paymentAllocations FeePaymentAllocation[]

  sequence Int

  periodStart DateTime? @db.Date
  periodEnd   DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentFeeItemId])
  @@index([feeInstallmentId])
  @@index([dueDate])
  @@index([status])
}

model FeePayment {
  id String @id @default(cuid())

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  studentEnrollmentId String
  studentEnrollment   StudentEnrollment @relation(fields: [studentEnrollmentId], references: [id])

  receiptNo String

  paymentDate DateTime @db.Date

  amount Decimal @db.Decimal(12, 2)

  paymentMode FeePaymentMode

  referenceNo String?

  remarks String?

  status FeePaymentStatus @default(SUCCESS)

  voidReason String?
  voidedAt   DateTime?
  voidedBy   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  allocations FeePaymentAllocation[]

  @@unique([schoolId, receiptNo])
  @@index([schoolId, studentEnrollmentId])
  @@index([paymentDate])
  @@index([status])
}

model FeePaymentAllocation {
  id String @id @default(cuid())

  paymentId String
  payment   FeePayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  studentFeeInstallmentId String
  studentFeeInstallment   StudentFeeInstallment @relation(fields: [studentFeeInstallmentId], references: [id])

  amount Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@unique([paymentId, studentFeeInstallmentId])
  @@index([studentFeeInstallmentId])
}

model Exam {
  id String @id @default(cuid())

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  name String

  startDate DateTime?
  endDate   DateTime?

  status ExamStatus @default(DRAFT)

  active Boolean @default(true)

  schedules ExamSchedule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, academicYearId, name])
  @@index([schoolId])
  @@index([academicYearId])
  @@index([schoolId, academicYearId])
}

model ExamSchedule {
  id String @id @default(cuid())

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  examId String
  exam   Exam   @relation(fields: [examId], references: [id], onDelete: Cascade)

  classId String
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  sectionId String?
  section   Section? @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  examDate DateTime @db.Date

  startTime String?
  endTime   String?

  maxMarks  Decimal  @db.Decimal(10, 2)
  passMarks Decimal? @db.Decimal(10, 2)

  marks StudentExamMark[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([examId, classId, sectionId, subjectId])
  @@index([schoolId])
  @@index([examId])
  @@index([classId, sectionId])
  @@index([subjectId])
}

model StudentExamMark {
  id String @id @default(cuid())

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  examScheduleId String
  examSchedule   ExamSchedule @relation(fields: [examScheduleId], references: [id], onDelete: Cascade)

  studentEnrollmentId String
  studentEnrollment   StudentEnrollment @relation(fields: [studentEnrollmentId], references: [id], onDelete: Cascade)

  marksObtained Decimal? @db.Decimal(10, 2)

  status StudentExamStatus @default(PRESENT)

  remarks String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([examScheduleId, studentEnrollmentId])
  @@index([schoolId])
  @@index([studentEnrollmentId])
  @@index([examScheduleId])
}

enum StudentFeeInstallmentStatus {
  PENDING
  PARTIAL
  PAID
  WAIVED
}

enum FeePaymentMode {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  CHEQUE
  ONLINE
}

enum FeePaymentStatus {
  SUCCESS
  CANCELLED
  REFUNDED
  VOID
}

enum FeeFrequency {
  MONTHLY
  QUARTERLY
  TERMLY
  HALF_YEARLY
  ANNUAL
  CUSTOM
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  LEAVE
}

enum AttendanceMode {
  ONCE_DAILY
  MORNING_AFTERNOON
  EVERY_PERIOD
}

enum AttendanceSessionType {
