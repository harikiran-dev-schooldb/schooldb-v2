  FATHER
  MOTHER
  GUARDIAN
  STUDENT
  OTHER
}

model SupportTicket {
  id           String                    @id @default(cuid())
  schoolId     String
  ticketNo     String
  subject      String
  description  String
  type         SupportTicketType
  priority     SupportTicketPriority     @default(NORMAL)
  status       SupportTicketStatus       @default(OPEN)
  studentId    String?
  createdById  String?
  source       String                    @default("STAFF")
  parentName   String?
  parentPhone  String?
  complaintBy  SupportTicketComplaintBy?
  diagnostics  Json?
  assignedToId String?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  resolvedAt   DateTime?
  school       School                    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student      Student?                  @relation(fields: [studentId], references: [id], onDelete: SetNull)
  createdBy    User?                     @relation("SupportTicketCreator", fields: [createdById], references: [id], onDelete: SetNull)
  assignedTo   User?                     @relation("SupportTicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  messages     SupportTicketMessage[]
  activities   SupportTicketActivity[]
  reads        SupportTicketRead[]
  attachments  SupportTicketAttachment[]

  @@unique([schoolId, ticketNo])
  @@index([schoolId, status, createdAt(sort: Desc)])
  @@index([schoolId, createdById])
  @@index([schoolId, source, createdAt(sort: Desc)])
  @@index([schoolId, assignedToId])
  @@index([schoolId, studentId])
}

model SupportTicketAttachment {
  id           String        @id @default(cuid())
  schoolId     String
  ticketId     String
  uploadedById String
  originalName String
  mimeType     String
  sizeBytes    Int
  storageKey   String        @unique
  createdAt    DateTime      @default(now())
  school       School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  ticket       SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  uploadedBy   User          @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([schoolId, ticketId, createdAt])
  @@index([uploadedById, createdAt])
}

model SupportTicketRead {
  id       String        @id @default(cuid())
  schoolId String
  ticketId String
  userId   String
  readAt   DateTime      @default(now())
  school   School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([ticketId, userId])
  @@index([schoolId, userId, readAt])
  @@index([userId, readAt])
}

model SupportTicketActivity {
  id        String        @id @default(cuid())
  schoolId  String
  ticketId  String
  actorId   String
  action    String
  detail    String
  createdAt DateTime      @default(now())
  school    School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor     User          @relation(fields: [actorId], references: [id])

  @@index([ticketId, createdAt])
  @@index([schoolId, createdAt])
}

model SupportTicketMessage {
  id         String        @id @default(cuid())
  schoolId   String
  ticketId   String
  authorId   String
  body       String
  isInternal Boolean       @default(false)
  createdAt  DateTime      @default(now())
  school     School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author     User          @relation(fields: [authorId], references: [id])

  @@index([ticketId, createdAt])
  @@index([ticketId, isInternal, createdAt])
  @@index([schoolId, createdAt])
}

