model CashfreePaymentOrder {
  id                  String                      @id @default(cuid())
  schoolId            String
  studentEnrollmentId String
  providerOrderId     String                      @unique
  providerPaymentId   String?                     @unique
  idempotencyKey      String                      @unique
  amount              Decimal                     @db.Decimal(12, 2)
  status              CashfreePaymentOrderStatus  @default(CREATED)
  paymentSessionId    String?
  requestedByUserId   String
  feePaymentId        String?                     @unique
  failureReason       String?                     @db.VarChar(500)
  paidAt              DateTime?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  publicTokenHash     String?                     @unique
  initiatedBy         CashfreePaymentInitiator    @default(SELF_SERVICE)
  allocations         CashfreePaymentAllocation[]
  feePayment          FeePayment?                 @relation(fields: [feePaymentId], references: [id])
  school              School                      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentEnrollment   StudentEnrollment           @relation(fields: [studentEnrollmentId], references: [id])

  @@index([schoolId, status, createdAt(sort: Desc)])
  @@index([studentEnrollmentId, status, createdAt(sort: Desc)])
}

