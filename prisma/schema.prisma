generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AcademicYear {
  admissionApplications AdmissionApplication[]
  id                    String                 @id @default(cuid())
  name                  String
  startDate             DateTime
  endDate               DateTime
  active                Boolean                @default(false)
  schoolId              String
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  attendanceMode        AttendanceMode         @default(ONCE_DAILY)
  academicPeriods       AcademicPeriod[]
  school                School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  attendanceSessions    AttendanceSession[]
  classSubjects         ClassSubject[]
  exams                 Exam[]
  feePlans              FeePlan[]
  homeworks             Homework[]
  enrollments           StudentEnrollment[]
  allocations           TeacherAllocation[]
  timetables            Timetable[]

  @@unique([schoolId, name])
}

model AcademicPeriod {
  id             String           @id @default(cuid())
  schoolId       String
  academicYearId String
  name           String
  shortName      String?
  startDate      DateTime         @db.Date
  endDate        DateTime         @db.Date
  sequence       Int
  active         Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  academicYear   AcademicYear     @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  school         School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  installments   FeeInstallment[]

  @@unique([academicYearId, name])
  @@unique([academicYearId, sequence])
  @@index([schoolId, academicYearId])
}

model School {
  admissionApplications AdmissionApplication[]
  admissionDocuments    AdmissionDocument[]
  admissionSetting      SchoolAdmissionSetting?
  auditLogs             AuditLog[]
  announcements         Announcement[]
  calendarEvents        SchoolCalendarEvent[]
  studentDocuments      StudentDocument[]
  whatsappCampaigns     WhatsappCampaign[]
  whatsappRecipients    WhatsappRecipient[]
  leaveRequests         LeaveRequest[]
  otpChallenges         OtpChallenge[]
  id                    String                       @id @default(cuid())
  name                  String
  slug                  String                       @unique
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt
  logo                  String?
  academicPeriods       AcademicPeriod[]
  academicYears         AcademicYear[]
  attendance            Attendance[]
  attendanceSessions    AttendanceSession[]
  classes               Class[]
  classSubjects         ClassSubject[]
  exams                 Exam[]
  examSchedules         ExamSchedule[]
  feeCategories         FeeCategory[]
  feePayments           FeePayment[]
  feePlans              FeePlan[]
  homeworks             Homework[]
  memberships           Membership[]
  parentStudentLinks    ParentStudentLink[]
  periods               Period[]
  students              Student[]
  activities            StudentActivity[]
  studentEnrollments    StudentEnrollment[]
  studentExamMarks      StudentExamMark[]
  studentFees           StudentFee[]
  subjects              Subject[]
  teachers              Teacher[]
  teacherAllocations    TeacherAllocation[]
  timetables            Timetable[]
  transportVehicles     TransportVehicle[]
  transportRoutes       TransportRoute[]
  transportStops        TransportStop[]
  transportAssignments  StudentTransportAssignment[]
  libraryCategories     LibraryCategory[]
  libraryBooks          LibraryBook[]
  libraryCopies         LibraryBookCopy[]
  libraryLoans          LibraryLoan[]
  idCardSetting         SchoolIdCardSetting?
  certificateSetting    SchoolCertificateSetting?
  certificateIssues     CertificateIssue[]
}

model SchoolIdCardSetting {
  id           String            @id @default(cuid())
  schoolId     String            @unique
  orientation  IdCardOrientation @default(PORTRAIT)
  widthMm      Decimal           @default(54.00) @db.Decimal(6, 2)
  heightMm     Decimal           @default(85.60) @db.Decimal(6, 2)
  showBack     Boolean           @default(true)
  backImageUrl String?
  backContent  String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  school       School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
}

model SchoolCertificateSetting {
  id              String   @id @default(cuid())
  schoolId        String   @unique
  headerSubtitle  String   @default("SchoolDB · Official record")
  bonafideContent String   @db.Text
  studyContent    String   @db.Text
  transferContent String   @db.Text
  footerNote      String?
  signatoryLabel  String   @default("Principal / Head of School")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  school          School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
}

model User {
  auditLogs          AuditLog[]
  announcementReads  AnnouncementRead[]
  id                 String              @id @default(cuid())
  clerkUserId        String              @unique
  email              String              @unique
  firstName          String?
  lastName           String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  imageUrl           String?
  phone              String?
  memberships        Membership[]
  parentStudentLinks ParentStudentLink[]
  otpChallenges      OtpChallenge[]

  @@index([phone])
}

model OtpChallenge {
  id               String    @id @default(cuid())
  schoolId         String
  userId           String
  candidateUserIds Json      @default("[]")
  phoneHash        String
  codeHash         String
  expiresAt        DateTime
  verifiedAt       DateTime?
  attempts         Int       @default(0)
  lastSentAt       DateTime  @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  school           School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([schoolId, phoneHash])
  @@index([expiresAt])
  @@index([userId])
}

model RequestRateLimit {
  keyHash      String   @id @db.VarChar(64)
  requestCount Int      @default(1)
  expiresAt    DateTime
  updatedAt    DateTime @updatedAt

  @@index([expiresAt])
}

model Announcement {
  id          String             @id @default(cuid())
  schoolId    String
  school      School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  title       String
  body        String
  category    String             @default("GENERAL")
  priority    String             @default("NORMAL")
  targetType  String             @default("SCHOOL")
  targetId    String?
  targetLabel String
  createdBy   String
  publishedAt DateTime
  expiresAt   DateTime?
  archived    Boolean            @default(false)
  createdAt   DateTime           @default(now())
  reads       AnnouncementRead[]

  @@index([schoolId, archived, publishedAt])
}

model AnnouncementRead {
  id             String       @id @default(cuid())
  announcementId String
  userId         String
  readAt         DateTime     @default(now())
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([userId])
}

model SchoolCalendarEvent {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  title       String
  description String?
  category    String   @default("EVENT")
  startDate   DateTime @db.Date
  endDate     DateTime @db.Date
  targetType  String   @default("SCHOOL")
  targetId    String?
  targetLabel String
  createdBy   String
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([schoolId, archived, startDate])
}

model Membership {
  id          String   @id @default(cuid())
  userId      String
  schoolId    String
  role        Role
  designation String?
  createdAt   DateTime @default(now())
  isActive    Boolean  @default(true)
  updatedAt   DateTime @default(now()) @updatedAt
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, schoolId])
  @@index([schoolId, isActive, role])
}

model AuditLog {
  id          String   @id @default(cuid())
  schoolId    String
  actorUserId String?
  actorName   String
  actorRole   String
  module      String
  action      String
  entityType  String
  entityId    String?
  summary     String
  metadata    Json?
  createdAt   DateTime @default(now())
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([schoolId, createdAt(sort: Desc)])
  @@index([schoolId, module, createdAt(sort: Desc)])
  @@index([schoolId, action, createdAt(sort: Desc)])
  @@index([schoolId, actorUserId, createdAt(sort: Desc)])
}

model Student {
  admissionApplications AdmissionApplication[]
  id                    String                 @id @default(cuid())
  admissionNo           String
  gender                Gender
  dob                   DateTime
  email                 String?
  schoolId              String
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  address               String?
  allergies             String?
  alternatePhone        String?
  apaarId               String?
  bloodGroup            String?
  caste                 String?
  category              Category?
  city                  String?
  clerkId               String?
  country               String?
  district              String?
  doctorName            String?
  doctorPhone           String?
  emisNo                String?
  fatherAadhar          String?
  fatherEmail           String?
  fatherIncome          Decimal?
  fatherName            String?
  fatherOccupation      String?
  fatherPhone           String?
  fatherQualification   String?
  fullName              String?
  guardianName          String?
  guardianPhone         String?
  guardianRelation      String?
  hostelRequired        Boolean                @default(false)
  imageUrl              String?
  joinedDate            DateTime?
  medicalConditions     String?
  motherAadhar          String?
  motherEmail           String?
  motherIncome          Decimal?
  motherName            String?
  motherOccupation      String?
  motherPhone           String?
  motherQualification   String?
  motherTongue          String?
  nationality           String?
  penNo                 String?
  phone                 String?
  pincode               String?
  religion              Religion?
  remarks               String?
  state                 String?
  status                StudentStatus          @default(ACTIVE)
  studentAadhar         String?
  subCaste              String?
  transportRequired     Boolean                @default(false)
  whatsappOptIn         Boolean                @default(false)
  whatsappOptInAt       DateTime?
  username              String?
  statusChangedAt       DateTime?
  statusRemarks         String?
  attendance            Attendance[]
  school                School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  activities            StudentActivity[]
  enrollments           StudentEnrollment[]
  parentLinks           ParentStudentLink[]
  leaveRequests         LeaveRequest[]
  documents             StudentDocument[]
  whatsappRecipients    WhatsappRecipient[]
  certificateIssues     CertificateIssue[]

  @@unique([schoolId, admissionNo])
  @@index([schoolId])
  @@index([status])
  @@index([schoolId, fullName])
  @@index([schoolId, phone])
  @@index([schoolId, status, createdAt])
}

enum CertificateIssueType {
  BONAFIDE
  STUDY
  TRANSFER
}

enum CertificateIssueStatus {
  ISSUED
  CANCELLED
}

model CertificateIssue {
  id               String                 @id @default(cuid())
  schoolId         String
  studentId        String
  type             CertificateIssueType
  status           CertificateIssueStatus @default(ISSUED)
  certificateNo    String                 @unique
  purpose          String?
  issuedByUserId   String
  issuedByName     String
  issuedAt         DateTime               @default(now())
  printCount       Int                    @default(0)
  lastPrintedAt    DateTime?
  cancelledAt      DateTime?
  cancelledByName  String?
  cancellationNote String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  school           School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student          Student                @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([schoolId, issuedAt])
  @@index([schoolId, status, issuedAt])
  @@index([schoolId, studentId, issuedAt])
  @@index([schoolId, type, issuedAt])
}

model WhatsappCampaign {
  id             String                 @id @default(cuid())
  schoolId       String
  title          String
  message        String
  templateName   String
  targetType     String
  targetId       String?
  targetLabel    String
  status         WhatsappCampaignStatus @default(QUEUED)
  recipientCount Int                    @default(0)
  sentCount      Int                    @default(0)
  deliveredCount Int                    @default(0)
  readCount      Int                    @default(0)
  failedCount    Int                    @default(0)
  createdBy      String
  scheduledAt    DateTime               @default(now())
  completedAt    DateTime?
  automatic      Boolean                @default(false)
  automationKey  String?
  sourceType     String?
  sourceId       String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  school         School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  recipients     WhatsappRecipient[]

  @@unique([schoolId, automationKey])
  @@index([schoolId, createdAt])
  @@index([schoolId, status, scheduledAt])
  @@index([schoolId, automatic, status, scheduledAt])
}

model WhatsappRecipient {
  id                String                  @id @default(cuid())
  schoolId          String
  campaignId        String
  studentId         String?
  recipientName     String
  phone             String
  status            WhatsappRecipientStatus @default(QUEUED)
  attempts          Int                     @default(0)
  providerMessageId String?
  errorMessage      String?
  lastAttemptAt     DateTime?
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  failedAt          DateTime?
  providerStatusAt  DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  campaign          WhatsappCampaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  school            School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student           Student?                @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@unique([campaignId, phone])
  @@unique([providerMessageId])
  @@index([schoolId, status, createdAt])
  @@index([campaignId, status])
  @@index([studentId])
}

model StudentDocument {
  id              String              @id @default(cuid())
  schoolId        String
  studentId       String
  type            StudentDocumentType
  name            String
  originalName    String
  mimeType        String
  sizeBytes       Int
  storageKey      String              @unique
  notes           String?
  visibleToFamily Boolean             @default(false)
  uploadedBy      String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  school          School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student         Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([schoolId, studentId, createdAt])
  @@index([schoolId, visibleToFamily])
}

model ParentStudentLink {
  id           String   @id @default(cuid())
  schoolId     String
  parentUserId String
  studentId    String
  relationship String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  school       School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  parentUser   User     @relation(fields: [parentUserId], references: [id], onDelete: Cascade)
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([schoolId, parentUserId, studentId])
  @@index([schoolId, parentUserId, active])
  @@index([schoolId, studentId, active])
}

model Class {
  admissionApplications AdmissionApplication[]
  id                    String                 @id @default(cuid())
  name                  String
  code                  String?
  schoolId              String
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  active                Boolean                @default(true)
  description           String?
  displayOrder          Int                    @default(0)
  attendanceSessions    AttendanceSession[]
  school                School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classSubjects         ClassSubject[]
  examSchedules         ExamSchedule[]
  feePlans              FeePlanClass[]
  homeworks             Homework[]
  sections              Section[]
  enrollments           StudentEnrollment[]
  allocations           TeacherAllocation[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model Section {
  admissionApplications AdmissionApplication[]
  id                    String                 @id @default(cuid())
  name                  String
  classId               String
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  active                Boolean                @default(true)
  displayOrder          Int                    @default(0)
  attendanceSessions    AttendanceSession[]
  examSchedules         ExamSchedule[]
  homeworks             Homework[]
  class                 Class                  @relation(fields: [classId], references: [id], onDelete: Cascade)
  enrollments           StudentEnrollment[]
  allocations           TeacherAllocation[]

  @@unique([classId, name])
  @@index([classId, active, displayOrder])
}

model AdmissionApplication {
  id                 String                     @id @default(cuid())
  applicationNo      String
  schoolId           String
  academicYearId     String
  applyingClassId    String
  preferredSectionId String?
  studentId          String?
  studentName        String
  gender             Gender
  dob                DateTime                   @db.Date
  studentAadhar      String?
  apaarId            String?
  previousSchool     String?
  fatherName         String?
  fatherPhone        String?
  motherName         String?
  motherPhone        String?
  guardianName       String?
  guardianPhone      String?
  guardianRelation   String?
  email              String?
  address            String?
  city               String?
  district           String?
  state              String?
  pincode            String?
  medicalConditions  String?
  transportRequired  Boolean                    @default(false)
  whatsappOptIn      Boolean                    @default(false)
  status             AdmissionApplicationStatus @default(SUBMITTED)
  notes              String?
  submittedAt        DateTime                   @default(now())
  reviewedAt         DateTime?
  convertedAt        DateTime?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  school             School                     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear       AcademicYear               @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  applyingClass      Class                      @relation(fields: [applyingClassId], references: [id], onDelete: Restrict)
  preferredSection   Section?                   @relation(fields: [preferredSectionId], references: [id], onDelete: SetNull)
  student            Student?                   @relation(fields: [studentId], references: [id], onDelete: SetNull)
  history            AdmissionStatusHistory[]
  documents          AdmissionDocument[]

  @@unique([schoolId, applicationNo])
  @@index([schoolId, status, submittedAt(sort: Desc)])
  @@index([schoolId, academicYearId, applyingClassId, status])
  @@index([schoolId, fatherPhone])
  @@index([schoolId, motherPhone])
  @@index([schoolId, guardianPhone])
  @@index([schoolId, studentAadhar])
}

model AdmissionDocument {
  id            String                @id @default(cuid())
  schoolId      String
  applicationId String
  type          AdmissionDocumentType
  originalName  String
  mimeType      String
  sizeBytes     Int
  storageKey    String                @unique
  createdAt     DateTime              @default(now())
  school        School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  application   AdmissionApplication  @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([schoolId, applicationId, createdAt])
}

model SchoolAdmissionSetting {
  id                 String   @id @default(cuid())
  schoolId           String   @unique
  automaticNumbering Boolean  @default(false)
  admissionPrefix    String   @default("")
  nextNumber         Int      @default(1)
  numberPadding      Int      @default(4)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  school             School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
}

model AdmissionStatusHistory {
  id            String                      @id @default(cuid())
  applicationId String
  fromStatus    AdmissionApplicationStatus?
  toStatus      AdmissionApplicationStatus
  note          String?
  changedBy     String
  createdAt     DateTime                    @default(now())
  application   AdmissionApplication        @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt(sort: Desc)])
}

model StudentEnrollment {
  id                   String                       @id @default(cuid())
  schoolId             String
  studentId            String
  academicYearId       String
  classId              String
  sectionId            String
  rollNo               Int?
  admissionDate        DateTime?
  active               Boolean                      @default(true)
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  promotedFromId       String?
  feePayments          FeePayment[]
  activities           StudentActivity[]
  academicYear         AcademicYear                 @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  class                Class                        @relation(fields: [classId], references: [id], onDelete: Cascade)
  promotedFrom         StudentEnrollment?           @relation("PromotionHistory", fields: [promotedFromId], references: [id])
  promotedTo           StudentEnrollment[]          @relation("PromotionHistory")
  school               School                       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  section              Section                      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  student              Student                      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  examMarks            StudentExamMark[]
  studentFees          StudentFee[]
  leaveRequests        LeaveRequest[]
  transportAssignments StudentTransportAssignment[]
  libraryLoans         LibraryLoan[]

  @@unique([studentId, academicYearId])
  @@unique([academicYearId, classId, sectionId, rollNo])
  @@index([schoolId])
  @@index([studentId])
  @@index([academicYearId])
  @@index([classId])
  @@index([sectionId])
  @@index([schoolId, active])
  @@index([schoolId, active, classId, sectionId])
  @@index([schoolId, academicYearId, active])
  @@index([academicYearId, classId, sectionId])
}

model TransportVehicle {
  id             String           @id @default(cuid())
  schoolId       String
  registrationNo String
  name           String?
  type           String           @default("BUS")
  capacity       Int
  driverName     String
  driverPhone    String
  attendantName  String?
  attendantPhone String?
  active         Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  school         School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  routes         TransportRoute[]

  @@unique([schoolId, registrationNo])
  @@index([schoolId, active])
}

model TransportRoute {
  id          String                       @id @default(cuid())
  schoolId    String
  vehicleId   String?
  code        String
  name        String
  pickupStart String?
  dropStart   String?
  active      Boolean                      @default(true)
  createdAt   DateTime                     @default(now())
  updatedAt   DateTime                     @updatedAt
  school      School                       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  vehicle     TransportVehicle?            @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  stops       TransportStop[]
  assignments StudentTransportAssignment[]

  @@unique([schoolId, code])
  @@index([schoolId, active])
  @@index([vehicleId])
}

model TransportStop {
  id          String                       @id @default(cuid())
  schoolId    String
  routeId     String
  name        String
  sequence    Int
  pickupTime  String?
  dropTime    String?
  monthlyFee  Decimal?                     @db.Decimal(12, 2)
  active      Boolean                      @default(true)
  createdAt   DateTime                     @default(now())
  updatedAt   DateTime                     @updatedAt
  school      School                       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  route       TransportRoute               @relation(fields: [routeId], references: [id], onDelete: Cascade)
  assignments StudentTransportAssignment[]

  @@unique([routeId, sequence])
  @@unique([routeId, name])
  @@index([schoolId, active])
  @@index([routeId, active, sequence])
}

model StudentTransportAssignment {
  id                  String            @id @default(cuid())
  schoolId            String
  studentEnrollmentId String
  routeId             String
  stopId              String
  pickupEnabled       Boolean           @default(true)
  dropEnabled         Boolean           @default(true)
  startDate           DateTime          @db.Date
  endDate             DateTime?         @db.Date
  active              Boolean           @default(true)
  notes               String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  school              School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentEnrollment   StudentEnrollment @relation(fields: [studentEnrollmentId], references: [id], onDelete: Cascade)
  route               TransportRoute    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  stop                TransportStop     @relation(fields: [stopId], references: [id], onDelete: Cascade)

  @@index([schoolId, active])
  @@index([studentEnrollmentId, active])
  @@index([routeId, active])
  @@index([stopId])
}

model LibraryCategory {
  id        String        @id @default(cuid())
  schoolId  String
  name      String
  active    Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  school    School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  books     LibraryBook[]

  @@unique([schoolId, name])
  @@index([schoolId, active])
}

model LibraryBook {
