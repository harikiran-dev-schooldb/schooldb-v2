generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  SCHOOL_ADMIN
  TEACHER
  ACCOUNTANT
  RECEPTIONIST
  PARENT
  STUDENT
}

model AcademicYear {
  id String @id @default(cuid())

  name String

  startDate DateTime

  endDate DateTime

  active Boolean @default(false)

  schoolId String

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  enrollments StudentEnrollment[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([schoolId, name])
}

model School {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  academicYears AcademicYear[]
  memberships   Membership[]
  students      Student[]
  classes       Class[]
  studentEnrollments StudentEnrollment[]
}

model User {
  id          String  @id @default(cuid())
  clerkUserId String  @unique
  email       String  @unique
  firstName   String?
  lastName    String?
  imageUrl    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
}

model Membership {
  id String @id @default(cuid())

  userId   String
  schoolId String

  role Role

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([userId, schoolId])
}

model Student {
  id String @id @default(cuid())

  // ==========================
  // Admission
  // ==========================

  admissionNo String
  username    String?
  clerkId     String?

  // ==========================
  // Basic Information
  // ==========================

  fullName String?

  gender     Gender
  dob        DateTime
  joinedDate DateTime?

  bloodGroup   String?
  nationality  String?
  motherTongue String?

  religion Religion?
  category Category?
  caste    String?
  subCaste String?

  // ==========================
  // Government IDs
  // ==========================

  penNo         String?
  emisNo        String?
  apaarId       String?
  studentAadhar String?

  // ==========================
  // Contact
  // ==========================

  phone          String?
  alternatePhone String?
  email          String?

  address  String?
  city     String?
  district String?
  state    String?
  country  String?
  pincode  String?

  // ==========================
  // Parent Information
  // ==========================

  fatherName          String?
  fatherPhone         String?
  fatherEmail         String?
  fatherOccupation    String?
  fatherQualification String?
  fatherIncome        Decimal?

  motherName          String?
  motherPhone         String?
  motherEmail         String?
  motherOccupation    String?
  motherQualification String?
  motherIncome        Decimal?

  guardianName     String?
  guardianRelation String?
  guardianPhone    String?

  // ==========================
  // Identity
  // ==========================

  fatherAadhar String?
  motherAadhar String?

  // ==========================
  // Medical
  // ==========================

  allergies         String?
  medicalConditions String?
  doctorName        String?
  doctorPhone       String?

  // ==========================
  // School
  // ==========================

  transportRequired Boolean @default(false)
  hostelRequired    Boolean @default(false)

  // These will become relations later
  academicYearId String?

  // ==========================
  // Photo
  // ==========================

  imageUrl String?

  // ==========================
  // Status
  // ==========================

  status StudentStatus @default(ACTIVE)

  statusChangedAt DateTime?

  statusRemarks String?

  remarks String?

  // ==========================
  // Tenant
  // ==========================

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  enrollments StudentEnrollment[]

  // ==========================
  // Audit
  // ==========================

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, admissionNo])
  @@index([schoolId])
  @@index([status])
}

model Class {
  id String @id @default(cuid())

  name        String
  code        String?
  description String?

  displayOrder Int @default(0)

  active Boolean @default(true)

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  sections Section[]
  enrollments StudentEnrollment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, name])
  @@index([schoolId])
}

model Section {
  id String @id @default(cuid())

  name String

  displayOrder Int @default(0)

  active Boolean @default(true)

  classId String
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  enrollments StudentEnrollment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classId, name])
}

model StudentEnrollment {
  id String @id @default(cuid())

  schoolId String
  school School @relation(fields: [schoolId], references: [id])

  studentId String
  student Student @relation(fields: [studentId], references: [id])

  academicYearId String
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  classId String
  class Class @relation(fields: [classId], references: [id])

  sectionId String
  section Section @relation(fields: [sectionId], references: [id])

  rollNo Int?

  admissionDate DateTime?

  active Boolean @default(true)

  promotedFromId String?
  promotedFrom StudentEnrollment? @relation("PromotionHistory", fields: [promotedFromId], references: [id])
  promotedTo StudentEnrollment[] @relation("PromotionHistory")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, academicYearId])

  @@index([schoolId])
  @@index([studentId])
  @@index([academicYearId])
  @@index([classId])
  @@index([sectionId])
}

enum StudentStatus {
  ACTIVE
  TC_ISSUED
  ALUMNI
  DROPPED
  NOT_COMING
  INACTIVE
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum Religion {
  HINDU
  MUSLIM
  CHRISTIAN
  SIKH
  BUDDHIST
  JAIN
  OTHER
}

enum Category {
  GENERAL
  OBC
  BC_A
  BC_B
  BC_C
  BC_D
  BC_E
  SC
  ST
  EWS
  RTE
}
