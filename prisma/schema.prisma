generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  SCHOOL_ADMIN
  TEACHER
  ACCOUNTANT
  RECEPTIONIST
  PARENT
  STUDENT
}

model AcademicYear {
  id String @id @default(cuid())

  name String

  startDate DateTime

  endDate DateTime

  active Boolean @default(false)

  schoolId String

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  enrollments StudentEnrollment[]
  allocations TeacherAllocation[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([schoolId, name])
}

model School {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  academicYears      AcademicYear[]
  memberships        Membership[]
  students           Student[]
  classes            Class[]
  studentEnrollments StudentEnrollment[]
  subjects           Subject[]
  teachers           Teacher[]
  teacherAllocations TeacherAllocation[]
}

model User {
  id          String  @id @default(cuid())
  clerkUserId String  @unique
  email       String  @unique
  firstName   String?
  lastName    String?
  imageUrl    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
}

model Membership {
  id String @id @default(cuid())

  userId   String
  schoolId String

  role Role

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([userId, schoolId])
}

model Student {
  id String @id @default(cuid())

  // ==========================
  // Admission
  // ==========================

  admissionNo String
  username    String?
  clerkId     String?

  // ==========================
  // Basic Information
  // ==========================

  fullName String?

  gender     Gender
  dob        DateTime
  joinedDate DateTime?

  bloodGroup   String?
  nationality  String?
  motherTongue String?

  religion Religion?
  category Category?
  caste    String?
  subCaste String?

  // ==========================
  // Government IDs
  // ==========================

  penNo         String?
  emisNo        String?
  apaarId       String?
  studentAadhar String?

  // ==========================
  // Contact
  // ==========================

  phone          String?
  alternatePhone String?
  email          String?

  address  String?
  city     String?
  district String?
  state    String?
  country  String?
  pincode  String?

  // ==========================
  // Parent Information
  // ==========================

  fatherName          String?
  fatherPhone         String?
  fatherEmail         String?
  fatherOccupation    String?
  fatherQualification String?
  fatherIncome        Decimal?

  motherName          String?
  motherPhone         String?
  motherEmail         String?
  motherOccupation    String?
  motherQualification String?
  motherIncome        Decimal?

  guardianName     String?
  guardianRelation String?
  guardianPhone    String?

  // ==========================
  // Identity
  // ==========================

  fatherAadhar String?
  motherAadhar String?

  // ==========================
  // Medical
  // ==========================

  allergies         String?
  medicalConditions String?
  doctorName        String?
  doctorPhone       String?

  // ==========================
  // School
  // ==========================

  transportRequired Boolean @default(false)
  hostelRequired    Boolean @default(false)

  // ==========================
  // Photo
  // ==========================

  imageUrl String?

  // ==========================
  // Status
  // ==========================

  status StudentStatus @default(ACTIVE)

  statusChangedAt DateTime?

  statusRemarks String?

  remarks String?

  // ==========================
  // Tenant
  // ==========================

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  enrollments StudentEnrollment[]

  // ==========================
  // Audit
  // ==========================

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, admissionNo])
  @@index([schoolId])
  @@index([status])
  @@index([schoolId, fullName])
  @@index([schoolId, phone])
}

model Class {
  id String @id @default(cuid())

  name        String
  code        String?
  description String?

  displayOrder Int @default(0)

  active Boolean @default(true)

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  sections    Section[]
  enrollments StudentEnrollment[]

  allocations TeacherAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, name])
  @@index([schoolId])
}

model Section {
  id String @id @default(cuid())

  name String

  displayOrder Int @default(0)

  active Boolean @default(true)

  classId String
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  enrollments StudentEnrollment[]
  allocations TeacherAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classId, name])
}

model StudentEnrollment {
  id String @id @default(cuid())

  schoolId String

  studentId String

  academicYearId String

  classId String

  sectionId String

  rollNo Int?

  admissionDate DateTime?

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  active Boolean @default(true)

  promotedFromId String?
  promotedFrom   StudentEnrollment?  @relation("PromotionHistory", fields: [promotedFromId], references: [id])
  promotedTo     StudentEnrollment[] @relation("PromotionHistory")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, academicYearId])
  @@unique([academicYearId, classId, sectionId, rollNo])
  @@index([schoolId])
  @@index([studentId])
  @@index([academicYearId])
  @@index([classId])
  @@index([sectionId])
  @@index([schoolId, active])
  @@index([academicYearId, classId, sectionId])
}

model Subject {
  id String @id @default(cuid())

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  name String
  code String?

  type SubjectType @default(SCHOLASTIC)

  displayOrder Int @default(0)

  active Boolean @default(true)

  allocations TeacherAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, name])
  @@index([schoolId])
}

model Teacher {
  id String @id @default(cuid())

  schoolId String
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  employeeId String

  clerkId String?
  username String?

  fullName String

  gender Gender

  dob DateTime?

  joiningDate DateTime?

  phone String?
  alternatePhone String?

  email String?

  qualification String?

  designation String?

  experience Int?

  bloodGroup String?

  imageUrl String?

  address String?

  city String?

  district String?

  state String?

  pincode String?

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  allocations TeacherAllocation[]

  @@unique([schoolId, employeeId])

  @@index([schoolId])
}

model TeacherAllocation {
  id String @id @default(cuid())

  schoolId String
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  academicYearId String
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  teacherId String
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  subjectId String
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  classId String
  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  sectionId String
  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  active Boolean @default(true)

  remarks String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId,academicYearId,teacherId,subjectId,classId,sectionId])
  @@index([schoolId])
}

enum SubjectType {
  SCHOLASTIC
  CO_SCHOLASTIC
}

enum StudentStatus {
  ACTIVE
  TC_ISSUED
  ALUMNI
  DROPPED
  NOT_COMING
  INACTIVE
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum Religion {
  HINDU
  MUSLIM
  CHRISTIAN
  SIKH
  BUDDHIST
  JAIN
  OTHER
}

enum Category {
  GENERAL
  OBC
  BC_A
  BC_B
  BC_C
  BC_D
  BC_E
  SC
  ST
  EWS
  RTE
}
