  @@unique([orderId, studentFeeInstallmentId])
  @@index([studentFeeInstallmentId])
}

model DirectUpiPaymentSubmission {
  id                  String                       @id @default(cuid())
  schoolId            String
  studentEnrollmentId String
  submittedByUserId   String
  utr                 String                       @db.VarChar(80)
  amount              Decimal                      @db.Decimal(12, 2)
  status              DirectUpiPaymentStatus       @default(PENDING)
  rejectionReason     String?                      @db.VarChar(500)
  reviewedByUserId    String?
  reviewedAt          DateTime?
  feePaymentId        String?                      @unique
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt
  school              School                       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentEnrollment   StudentEnrollment            @relation(fields: [studentEnrollmentId], references: [id], onDelete: Cascade)
  submittedBy         User                         @relation("DirectUpiSubmittedBy", fields: [submittedByUserId], references: [id], onDelete: Cascade)
  reviewedBy          User?                        @relation("DirectUpiReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  feePayment          FeePayment?                  @relation(fields: [feePaymentId], references: [id], onDelete: SetNull)
  allocations         DirectUpiPaymentAllocation[]

  @@unique([schoolId, utr])
  @@index([schoolId, status, createdAt(sort: Desc)])
  @@index([studentEnrollmentId, status, createdAt(sort: Desc)])
  @@index([submittedByUserId, createdAt(sort: Desc)])
  @@index([reviewedByUserId, reviewedAt(sort: Desc)])
}

