generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AcademicYear {
  id                      String                   @id @default(cuid())
  name                    String
  startDate               DateTime
  endDate                 DateTime
  active                  Boolean                  @default(false)
  schoolId                String
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  attendanceMode          AttendanceMode           @default(ONCE_DAILY)
  academicPeriods         AcademicPeriod[]
  school                  School                   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  admissionApplications   AdmissionApplication[]
  attendanceSessions      AttendanceSession[]
  classSubjects           ClassSubject[]
  exams                   Exam[]
  feePlans                FeePlan[]
  homeworks               Homework[]
  enrollments             StudentEnrollment[]
  allocations             TeacherAllocation[]
  classTeacherAssignments ClassTeacherAssignment[]
  timetables              Timetable[]
  studentHouses           StudentHouse[]

  @@unique([schoolId, name])
}

model AcademicPeriod {
  id             String           @id @default(cuid())
  schoolId       String
  academicYearId String
  name           String
  shortName      String?
  startDate      DateTime         @db.Date
  endDate        DateTime         @db.Date
  sequence       Int
  active         Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  academicYear   AcademicYear     @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  school         School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  installments   FeeInstallment[]

  @@unique([academicYearId, name])
  @@unique([academicYearId, sequence])
  @@index([schoolId, academicYearId])
}

model School {
  id                          String                       @id @default(cuid())
  name                        String
  slug                        String                       @unique
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  logo                        String?
  directUpiEnabled            Boolean                      @default(false)
  directUpiId                 String?                      @db.VarChar(120)
  directUpiPayeeName          String?                      @db.VarChar(160)
  routeAccessRestricted       Boolean                      @default(false)
  allowedRoutes               String[]                     @default([])
  academicPeriods             AcademicPeriod[]
  academicYears               AcademicYear[]
  academicBranches            AcademicBranch[]
  admissionApplications       AdmissionApplication[]
  admissionDocuments          AdmissionDocument[]
  announcements               Announcement[]
  attendance                  Attendance[]
  attendanceSessions          AttendanceSession[]
  auditLogs                   AuditLog[]
  cashfreePaymentOrders       CashfreePaymentOrder[]
  directUpiPaymentSubmissions DirectUpiPaymentSubmission[]
  certificateIssues           CertificateIssue[]
  classes                     Class[]
  classSubjects               ClassSubject[]
  exams                       Exam[]
  examSchedules               ExamSchedule[]
  expenses                    Expense[]
  feeCategories               FeeCategory[]
  feePayments                 FeePayment[]
  feePlans                    FeePlan[]
  homeworks                   Homework[]
  leaveRequests               LeaveRequest[]
  libraryBooks                LibraryBook[]
  libraryCopies               LibraryBookCopy[]
  libraryCategories           LibraryCategory[]
  libraryLoans                LibraryLoan[]
  memberships                 Membership[]
  otpChallenges               OtpChallenge[]
  parentStudentLinks          ParentStudentLink[]
  periods                     Period[]
  pushDevices                 PushDevice[]
  pushDeliveryReports         PushDeliveryReport[]
  notificationPreferences     NotificationPreference[]
  admissionSetting            SchoolAdmissionSetting?
  calendarEvents              SchoolCalendarEvent[]
  certificateSetting          SchoolCertificateSetting?
  idCardSetting               SchoolIdCardSetting?
  students                    Student[]
  activities                  StudentActivity[]
  studentDocuments            StudentDocument[]
  studentEnrollments          StudentEnrollment[]
  studentExamMarks            StudentExamMark[]
  studentFees                 StudentFee[]
  transportAssignments        StudentTransportAssignment[]
  subjects                    Subject[]
  syllabi                     Syllabus[]
  teachers                    Teacher[]
  teacherAllocations          TeacherAllocation[]
  classTeacherAssignments     ClassTeacherAssignment[]
  timetables                  Timetable[]
  transportRoutes             TransportRoute[]
  transportStops              TransportStop[]
  transportVehicles           TransportVehicle[]
  whatsappCampaigns           WhatsappCampaign[]
  whatsappRecipients          WhatsappRecipient[]
  houses                      House[]
  studentHouses               StudentHouse[]
  supportTickets              SupportTicket[]
  supportTicketMessages       SupportTicketMessage[]
  supportTicketActivities     SupportTicketActivity[]
  supportTicketReads          SupportTicketRead[]
  supportTicketAttachments    SupportTicketAttachment[]
  androidAppBuilds            AndroidAppBuild[]
  studentProfileImageRequests StudentProfileImageRequest[]
  reportExportJobs            ReportExportJob[]
  staffAttendances            StaffAttendance[]
  staffLeaveRequests          StaffLeaveRequest[]
  salaryStructures            SalaryStructure[]
  payrollRuns                 PayrollRun[]
  payrollEntries              PayrollEntry[]
  visitors                    VisitorLog[]
  studentHealthRecords        StudentHealthRecord[]
  studentHealthVisits         StudentHealthVisit[]
  inventoryItems              InventoryItem[]
  inventoryMovements          InventoryMovement[]
  pickupAuthorizations        PickupAuthorization[]
  maintenanceTickets          MaintenanceTicket[]
}

model SchoolIdCardSetting {
  id           String            @id @default(cuid())
  schoolId     String            @unique
  orientation  IdCardOrientation @default(PORTRAIT)
  widthMm      Decimal           @default(54.00) @db.Decimal(6, 2)
  heightMm     Decimal           @default(85.60) @db.Decimal(6, 2)
  showBack     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  backContent  String?
  backImageUrl String?
  school       School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
}

model SchoolCertificateSetting {
  id              String   @id @default(cuid())
  schoolId        String   @unique
  headerSubtitle  String   @default("SchoolDB · Official record")
  bonafideContent String
  studyContent    String
  transferContent String
  footerNote      String?
  signatoryLabel  String   @default("Principal / Head of School")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  school          School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
}

model User {
  id                          String                       @id @default(cuid())
  clerkUserId                 String                       @unique
  email                       String                       @unique
  firstName                   String?
  lastName                    String?
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  imageUrl                    String?
  phone                       String?
  announcementReads           AnnouncementRead[]
  auditLogs                   AuditLog[]
  memberships                 Membership[]
  otpChallenges               OtpChallenge[]
  parentStudentLinks          ParentStudentLink[]
  pushDevices                 PushDevice[]
  initiatedPushReports        PushDeliveryReport[]         @relation("PushDeliveryReportInitiator")
  notificationPreferences     NotificationPreference[]
  createdSupportTickets       SupportTicket[]              @relation("SupportTicketCreator")
  assignedSupportTickets      SupportTicket[]              @relation("SupportTicketAssignee")
  supportTicketMessages       SupportTicketMessage[]
  supportTicketActivities     SupportTicketActivity[]
  supportTicketReads          SupportTicketRead[]
  supportTicketAttachments    SupportTicketAttachment[]
  androidAppBuilds            AndroidAppBuild[]
  performedStudentActivities  StudentActivity[]            @relation("StudentActivityPerformer")
  studentProfileImageRequests StudentProfileImageRequest[]
  reportExportJobs            ReportExportJob[]
  submittedDirectUpiPayments  DirectUpiPaymentSubmission[] @relation("DirectUpiSubmittedBy")
  reviewedDirectUpiPayments   DirectUpiPaymentSubmission[] @relation("DirectUpiReviewedBy")

  @@index([phone])
}

model OtpChallenge {
  id               String    @id @default(cuid())
  schoolId         String
  userId           String
  phoneHash        String
  codeHash         String
  expiresAt        DateTime
  attempts         Int       @default(0)
  lastSentAt       DateTime  @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  candidateUserIds Json      @default("[]")
  verifiedAt       DateTime?
  consumedAt       DateTime?
  school           School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([schoolId, phoneHash])
  @@index([expiresAt])
  @@index([userId])
}

model RequestRateLimit {
  keyHash      String   @id @db.VarChar(64)
  requestCount Int      @default(1)
  expiresAt    DateTime
  updatedAt    DateTime @updatedAt

  @@index([expiresAt])
}

model Announcement {
  id          String             @id @default(cuid())
  schoolId    String
  title       String
  body        String
  category    String             @default("GENERAL")
  priority    String             @default("NORMAL")
  targetType  String             @default("SCHOOL")
  targetId    String?
  targetLabel String
  sourceType  String?
  sourceId    String?
  dedupeKey   String?            @unique
  createdBy   String
  publishedAt DateTime
  expiresAt   DateTime?
  archived    Boolean            @default(false)
  createdAt   DateTime           @default(now())
  school      School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  reads       AnnouncementRead[]

  @@index([schoolId, archived, publishedAt])
  @@index([schoolId, sourceType, sourceId])
}

model AnnouncementRead {
  id             String       @id @default(cuid())
  announcementId String
  userId         String
  readAt         DateTime     @default(now())
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([userId])
}

model PushDevice {
  id                  String   @id @default(cuid())
  schoolId            String
  userId              String
  installationId      String   @unique
  fcmToken            String?
  webPushSubscription Json?
  app                 String   @default("SCHOOLDB")
  platform            String   @default("ANDROID")
  appVersion          String?
  enabled             Boolean  @default(true)
  lastSeenAt          DateTime @default(now())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  school              School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([schoolId, enabled])
  @@index([userId, enabled])
}

model NotificationPreference {
  id            String   @id @default(cuid())
  schoolId      String
  userId        String
  announcements Boolean  @default(true)
  homework      Boolean  @default(true)
  attendance    Boolean  @default(true)
  fees          Boolean  @default(true)
  exams         Boolean  @default(true)
  leaveUpdates  Boolean  @default(true)
  urgent        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([schoolId, userId])
  @@index([userId])
}

model PushDeliveryReport {
  id                     String   @id @default(cuid())
  schoolId               String
  announcementId         String?
  initiatedByUserId      String?
  kind                   String   @default("ANNOUNCEMENT")
  title                  String
  audienceUsers          Int      @default(0)
  preferenceEnabledUsers Int      @default(0)
  eligibleDevices        Int      @default(0)
  noDeviceUsers          Int      @default(0)
  iosDevices             Int      @default(0)
  standardWebDevices     Int      @default(0)
  firebaseDevices        Int      @default(0)
  accepted               Int      @default(0)
  failed                 Int      @default(0)
  invalidDevices         Int      @default(0)
  status                 String
  createdAt              DateTime @default(now())
  school                 School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  initiatedByUser        User?    @relation("PushDeliveryReportInitiator", fields: [initiatedByUserId], references: [id], onDelete: SetNull)

  @@index([schoolId, createdAt])
  @@index([schoolId, announcementId])
  @@index([initiatedByUserId, createdAt])
}

model SchoolCalendarEvent {
  id          String   @id @default(cuid())
  schoolId    String
  title       String
  description String?
  category    String   @default("EVENT")
  startDate   DateTime @db.Date
  endDate     DateTime @db.Date
  targetType  String   @default("SCHOOL")
  targetId    String?
  targetLabel String
  createdBy   String
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, archived, startDate])
}

model Membership {
  id                       String   @id @default(cuid())
  userId                   String
  schoolId                 String
  role                     Role
  createdAt                DateTime @default(now())
  isActive                 Boolean  @default(true)
  updatedAt                DateTime @default(now()) @updatedAt
  designation              String?
  customPermissionsEnabled Boolean  @default(false)
  permissions              String[] @default([])
  school                   School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, schoolId])
  @@index([schoolId, isActive, role])
}

model AuditLog {
  id          String   @id @default(cuid())
  schoolId    String
  actorUserId String?
  actorName   String
  actorRole   String
  module      String
  action      String
  entityType  String
  entityId    String?
  summary     String
  metadata    Json?
  createdAt   DateTime @default(now())
  actor       User?    @relation(fields: [actorUserId], references: [id])
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, createdAt(sort: Desc)])
  @@index([schoolId, module, createdAt(sort: Desc)])
  @@index([schoolId, action, createdAt(sort: Desc)])
  @@index([schoolId, actorUserId, createdAt(sort: Desc)])
}

model Student {
  id                    String                      @id @default(cuid())
  admissionNo           String
  gender                Gender
  dob                   DateTime
  email                 String?
  schoolId              String
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  address               String?
  allergies             String?
  alternatePhone        String?
  apaarId               String?
  bloodGroup            String?
  caste                 String?
  category              Category?
  city                  String?
  clerkId               String?
  country               String?
  district              String?
  doctorName            String?
  doctorPhone           String?
  emisNo                String?
  fatherAadhar          String?
  fatherEmail           String?
  fatherIncome          Decimal?
  fatherName            String?
  fatherOccupation      String?
  fatherPhone           String?
  fatherQualification   String?
  fullName              String?
  guardianName          String?
  guardianPhone         String?
  guardianRelation      String?
  hostelRequired        Boolean                     @default(false)
  isRte                 Boolean                     @default(false)
  imageUrl              String?
  joinedDate            DateTime?
  medicalConditions     String?
  motherAadhar          String?
  motherEmail           String?
  motherIncome          Decimal?
  motherName            String?
  motherOccupation      String?
  motherPhone           String?
  motherQualification   String?
  motherTongue          String?
  nationality           String?
  penNo                 String?
  phone                 String?
  pincode               String?
  religion              Religion?
  remarks               String?
  state                 String?
  status                StudentStatus               @default(ACTIVE)
  studentAadhar         String?
  subCaste              String?
  transportRequired     Boolean                     @default(false)
  username              String?
  statusChangedAt       DateTime?
  statusRemarks         String?
  whatsappOptIn         Boolean                     @default(false)
  whatsappOptInAt       DateTime?
  admissionApplications AdmissionApplication[]
  attendance            Attendance[]
  certificateIssues     CertificateIssue[]
  leaveRequests         LeaveRequest[]
  parentLinks           ParentStudentLink[]
  school                School                      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  activities            StudentActivity[]
  documents             StudentDocument[]
  enrollments           StudentEnrollment[]
  whatsappRecipients    WhatsappRecipient[]
  houseAssignments      StudentHouse[]
  supportTickets        SupportTicket[]
  profileImageRequest   StudentProfileImageRequest?
  healthRecord          StudentHealthRecord?
  healthVisits          StudentHealthVisit[]
  pickupAuthorizations  PickupAuthorization[]

  @@unique([schoolId, admissionNo])
  @@index([schoolId])
  @@index([status])
  @@index([schoolId, fullName])
  @@index([schoolId, phone])
  @@index([schoolId, status, createdAt])
  @@index([schoolId, isRte, status])
}

model VisitorLog {
  id              String    @id @default(cuid())
  schoolId        String
  visitorName     String    @db.VarChar(160)
  phone           String    @db.VarChar(24)
  purpose         String    @db.VarChar(300)
  personToMeet    String?   @db.VarChar(160)
  idProofType     String?   @db.VarChar(60)
  idProofLastFour String?   @db.VarChar(4)
  gatePassCode    String    @db.VarChar(20)
  vehicleNumber   String?   @db.VarChar(30)
  checkInAt       DateTime  @default(now())
  checkOutAt      DateTime?
  status          String    @default("CHECKED_IN") @db.VarChar(24)
  recordedBy      String
  notes           String?   @db.VarChar(500)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  school          School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, gatePassCode])
  @@index([schoolId, status, checkInAt(sort: Desc)])
  @@index([schoolId, phone])
}

model StudentHealthRecord {
  id                 String   @id @default(cuid())
  schoolId           String
  studentId          String   @unique
  bloodGroup         String?  @db.VarChar(12)
  allergies          String?  @db.VarChar(1000)
  medicalConditions  String?  @db.VarChar(1000)
  medications        String?  @db.VarChar(1000)
  accessibilityNeeds String?  @db.VarChar(1000)
  emergencyContact   String?  @db.VarChar(160)
  emergencyPhone     String?  @db.VarChar(24)
  physicianName      String?  @db.VarChar(160)
  physicianPhone     String?  @db.VarChar(24)
  insuranceDetails   String?  @db.VarChar(500)
  consentNotes       String?  @db.VarChar(1000)
  updatedBy          String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  school             School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student            Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([schoolId, updatedAt(sort: Desc)])
}

model StudentHealthVisit {
  id               String    @id @default(cuid())
  schoolId         String
  studentId        String
  occurredAt       DateTime  @default(now())
  complaint        String    @db.VarChar(500)
  actionTaken      String    @db.VarChar(1000)
  disposition      String    @default("RETURNED_TO_CLASS") @db.VarChar(40)
  guardianNotified Boolean   @default(false)
  followUpAt       DateTime?
  recordedBy       String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  school           School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student          Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([schoolId, occurredAt(sort: Desc)])
  @@index([studentId, occurredAt(sort: Desc)])
}

model InventoryItem {
  id            String              @id @default(cuid())
  schoolId      String
  assetCode     String
  name          String              @db.VarChar(160)
  category      String              @db.VarChar(80)
  location      String?             @db.VarChar(120)
  quantity      Int                 @default(0)
  reorderLevel  Int                 @default(0)
  unitCost      Decimal?            @db.Decimal(12, 2)
  condition     String              @default("GOOD") @db.VarChar(24)
  custodian     String?             @db.VarChar(160)
  purchaseDate  DateTime?           @db.Date
  warrantyUntil DateTime?           @db.Date
  active        Boolean             @default(true)
  createdBy     String
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  school        School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  movements     InventoryMovement[]

  @@unique([schoolId, assetCode])
  @@index([schoolId, active, category])
  @@index([schoolId, quantity, reorderLevel])
}

model InventoryMovement {
  id         String        @id @default(cuid())
  schoolId   String
  itemId     String
  type       String        @db.VarChar(24)
  quantity   Int
  reference  String?       @db.VarChar(120)
  notes      String?       @db.VarChar(500)
  recordedBy String
  createdAt  DateTime      @default(now())
  school     School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  item       InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([schoolId, createdAt(sort: Desc)])
  @@index([itemId, createdAt(sort: Desc)])
}

model PickupAuthorization {
  id             String    @id @default(cuid())
  schoolId       String
  studentId      String
  authorizedName String    @db.VarChar(160)
  relationship   String    @db.VarChar(80)
  phone          String    @db.VarChar(24)
  photoUrl       String?
  validFrom      DateTime  @db.Date
  validUntil     DateTime? @db.Date
  pickupCode     String    @db.VarChar(20)
  recurring      Boolean   @default(false)
  status         String    @default("ACTIVE") @db.VarChar(24)
  approvedBy     String
  notes          String?   @db.VarChar(500)
  lastUsedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  school         School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student        Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([schoolId, pickupCode])
  @@index([schoolId, status, validFrom])
  @@index([studentId, status])
}

model MaintenanceTicket {
  id            String    @id @default(cuid())
  schoolId      String
  ticketNo      String
  title         String    @db.VarChar(180)
  description   String    @db.VarChar(1500)
  category      String    @db.VarChar(80)
  location      String?   @db.VarChar(120)
  priority      String    @default("MEDIUM") @db.VarChar(24)
  status        String    @default("OPEN") @db.VarChar(24)
  assignedTo    String?   @db.VarChar(160)
  estimatedCost Decimal?  @db.Decimal(12, 2)
  actualCost    Decimal?  @db.Decimal(12, 2)
  dueDate       DateTime? @db.Date
  resolvedAt    DateTime?
  resolution    String?   @db.VarChar(1000)
  reportedBy    String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  school        School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, ticketNo])
  @@index([schoolId, status, priority, createdAt(sort: Desc)])
}

model StudentProfileImageRequest {
  id                String   @id @default(cuid())
  schoolId          String
  studentId         String   @unique
  requestedByUserId String
  storageKey        String
  mimeType          String
  originalName      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  school            School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student           Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  requestedBy       User     @relation(fields: [requestedByUserId], references: [id], onDelete: Cascade)

  @@index([schoolId, createdAt])
  @@index([requestedByUserId])
}

model House {
  id           String         @id @default(cuid())
  schoolId     String
  name         String
  code         String?
  color        String?
  description  String?
  iconUrl      String?
  displayOrder Int            @default(0)
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  school       School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  students     StudentHouse[]

  @@unique([schoolId, name])
  @@unique([schoolId, code])
  @@index([schoolId, active, displayOrder])
}

model StudentHouse {
  id                  String            @id @default(cuid())
  schoolId            String
  academicYearId      String
  studentId           String
  studentEnrollmentId String            @unique
  houseId             String
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  school              School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear        AcademicYear      @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  student             Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentEnrollment   StudentEnrollment @relation(fields: [studentEnrollmentId], references: [id], onDelete: Cascade)
  house               House             @relation(fields: [houseId], references: [id], onDelete: Cascade)

  @@unique([academicYearId, studentId])
  @@index([schoolId, academicYearId, houseId])
  @@index([schoolId, studentId])
}

model CertificateIssue {
  id               String                 @id @default(cuid())
  schoolId         String
  studentId        String
  type             CertificateIssueType
  status           CertificateIssueStatus @default(ISSUED)
  certificateNo    String                 @unique
  purpose          String?
  issuedByUserId   String
  issuedByName     String
  issuedAt         DateTime               @default(now())
