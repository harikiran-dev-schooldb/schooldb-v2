# PostgreSQL (use a pooled production connection URL when your provider supplies one)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
# Direct (non-pooler) URL used by Prisma migrations and admin tooling.
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@DIRECT_HOST:5432/DATABASE?schema=public"
DATABASE_POOL_MAX=10
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_POOL_CONNECT_TIMEOUT_MS=10000
DATABASE_APPLICATION_NAME=schooldb

# Private document storage
# Local development/self-hosting fallback:
SCHOOLDB_PRIVATE_STORAGE_DIR=.schooldb-storage
# Production Vercel Blob (created when a Blob store is connected):
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=

# Set only after provider-managed daily PostgreSQL backups are enabled
SCHOOLDB_DATABASE_BACKUPS_CONFIRMED=false

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# One-time secret required together with a signed-in Clerk account for the first SUPER_ADMIN.
SCHOOLDB_BOOTSTRAP_SECRET=

# Firebase Cloud Messaging (server-side service-account fields)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Preserve escaped newlines when storing this in an environment variable.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"

# Firebase web app configuration for opt-in browser push notifications
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Firebase Console > Project settings > Cloud Messaging > Web Push certificates
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Standards-based Web Push (required for iPhone/iPad Home Screen PWAs and Safari)
# Generate a pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_WEB_PUSH_VAPID_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:support@schooldb.co.in

# Cashfree Payments (start with sandbox; switch only after go-live checks)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
# Required for live Cashfree return and webhook URLs (for example https://school.example.com)
NEXT_PUBLIC_BASE_URL=https://www.schooldb.co.in

# WhatsApp Cloud API
META_PHONE_NUMBER_ID=
META_WA_TOKEN=
META_APP_SECRET=
META_WABA_ID=
META_WA_API_VERSION=v22.0
META_WA_OTP_TEMPLATE=otp_login
META_WA_PARENT_QUERY_TEMPLATE=school_parent_query_update
META_WA_ATTENDANCE_TEMPLATE=school_attendance_alert
META_WA_STAFF_ATTENDANCE_TEMPLATE=school_staff_attendance_alert
META_WA_ATTENDANCE_CORRECTION_TEMPLATE=school_attendance_correction
META_WA_BIRTHDAY_TEMPLATE=school_birthday_wish
META_WA_ADMISSION_TEMPLATE=school_admission_update
META_WA_PROMOTION_TEMPLATE=school_promotion_update
META_WA_ANNOUNCEMENT_LANGUAGE=en
META_WA_TIMEOUT_MS=35000
META_WA_AUTOMATION_ENABLED=false
META_WA_WEBHOOK_VERIFY_TOKEN=
CRON_SECRET=

# OTP protection (per school, fixed 10-minute window by default)
OTP_RATE_LIMIT_WINDOW_MS=600000
OTP_PHONE_LIMIT=5
OTP_IP_LIMIT=20
OTP_VERIFY_PHONE_LIMIT=10
OTP_VERIFY_IP_LIMIT=50

# Optional load-test overrides
LOAD_TEST_URL=http://localhost:3000/api/health
LOAD_TEST_CONCURRENCY=25
LOAD_TEST_DURATION_SECONDS=15
LOAD_TEST_MAX_ERROR_RATE=1
LOAD_TEST_MAX_P95_MS=1000

# Browser end-to-end tests
# Leave E2E_BASE_URL empty to let Playwright start the local Next.js server.
E2E_BASE_URL=
E2E_SCHOOL_SLUG=
# Create this file with Playwright codegen after signing into a dedicated test account.
E2E_AUTH_STATE=playwright/.auth/admin.json
# Mutating attendance/notification scenarios must remain disabled outside a disposable test tenant.
E2E_ALLOW_ATTENDANCE_MUTATIONS=false

# Android App Builder (fine-grained GitHub token with Actions: write)
GITHUB_ACTIONS_TOKEN=
GITHUB_ANDROID_REPOSITORY=harikiran-dev-schooldb/schooldb-v2
GITHUB_ANDROID_BUILD_WORKFLOW=android-school-build.yml
GITHUB_ANDROID_BUILD_REF=main
